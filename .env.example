# Local defaults; first semantic run downloads public ONNX models.
DENTAL_BACKEND=semantic
DENTAL_GENERATOR=extractive
DENTAL_DATA_DIR=data
DENTAL_CACHE_DIR=.cache
DENTAL_TRACE_PATH=artifacts/traces.jsonl
# Optional cloud packages: pip install -e ".[cloud,eval]"
# Groq: set your real key in .env and change DENTAL_GENERATOR to groq.
GROQ_API_KEY=
DENTAL_GROQ_MODEL=openai/gpt-oss-120b
# Fallback is skipped until this placeholder is replaced with a real Gemini key.
GEMINI_API_KEY=replace_with_your_gemini_api_key
DENTAL_GEMINI_MODEL=gemini-2.5-flash
DENTAL_GEMINI_FALLBACK_ENABLED=true
OPENAI_API_KEY=
DENTAL_OPENAI_MODEL=gpt-4.1-mini
DENTAL_JUDGE_MODEL=gpt-4.1-mini
# Optional prices in USD per million tokens, supplied by you (no guessed prices).
DENTAL_INPUT_PRICE_PER_MILLION=
DENTAL_OUTPUT_PRICE_PER_MILLION=
# Tracing is opt-in; queries/context are sent to your Langfuse instance.
DENTAL_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
